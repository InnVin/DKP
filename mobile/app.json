{
  "expo": {
    "name": "АвтоДоговор",
    "slug": "autodogovor",
    "scheme": "autodogovor",
    "version": "1.0.1.1",
    "orientation": "portrait",
    "icon": "./assets/autodogovor-icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ru.avtodogovor.mobile",
      "buildNumber": "3",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Биометрия защищает персональные данные в архиве договоров."
      }
    },
    "android": {
      "package": "ru.avtodogovor.mobile",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#071A3A",
        "foregroundImage": "./assets/autodogovor-icon.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "CAMERA",
        "USE_BIOMETRIC"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Доступ нужен только для выбора фотографий документов.",
          "cameraPermission": "Камера нужна для съёмки паспорта, ПТС, СТС и договора.",
          "microphonePermission": false
        }
      ],
      [
        "expo-sharing",
        {
          "ios": {
            "enabled": true
          },
          "android": {
            "enabled": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/autodogovor-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#071A3A",
          "dark": {
            "backgroundColor": "#071A3A"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
