        <item name="colorPrimary">#14B8A6</item>
        <item name="colorPrimaryDark">#0F766E</item>
        <item name="colorAccent">#2DD4BF</item>
        <item name="android:statusBarColor">#0B1220</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
